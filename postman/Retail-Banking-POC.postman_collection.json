{
  "info": {
    "name": "Retail Banking POC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customerId",
      "value": "1"
    },
    {
      "key": "accountId",
      "value": "1"
    },
    {
      "key": "targetAccountId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"demo\", \"password\": \"Demo@12345\", \"role\": \"CUSTOMER\"}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"demo\", \"password\": \"Demo@12345\"}"
        }
      }
    },
    {
      "name": "Create Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers",
        "body": {
          "mode": "raw",
          "raw": "{\"firstName\": \"Aarav\", \"lastName\": \"Sharma\", \"dateOfBirth\": \"1995-04-18\", \"email\": \"aarav@example.com\", \"phoneNumber\": \"+919876543210\", \"address\": \"Pune\"}"
        }
      }
    },
    {
      "name": "Create Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/accounts",
        "body": {
          "mode": "raw",
          "raw": "{\"customerId\": 1, \"accountType\": \"SAVINGS\", \"initialDeposit\": 10000}"
        }
      }
    },
    {
      "name": "Transfer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "transfer-demo-001"
          }
        ],
        "url": "{{baseUrl}}/api/v1/accounts/transfers",
        "body": {
          "mode": "raw",
          "raw": "{\"sourceAccountId\": 1, \"targetAccountId\": 2, \"amount\": 500, \"description\": \"Demo transfer\"}"
        }
      }
    },
    {
      "name": "Apply Loan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/loans",
        "body": {
          "mode": "raw",
          "raw": "{\"customerId\": 1, \"accountId\": 1, \"principal\": 50000, \"annualInterestRate\": 12, \"termMonths\": 12, \"monthlyIncome\": 60000, \"creditScore\": 720}"
        }
      }
    }
  ]
}